{
  "manifestVersion": 1,
  "harness": "hermes",
  "name": "uffici-for-hermes",
  "version": "0.0.0",
  "pluginDir": "plugins/uffici-for-hermes",
  "homeEnv": "HERMES_HOME",
  "defaultHome": "~/.hermes",
  "enable": ["hermes", "plugins", "enable", "uffici-for-hermes"],
  "configSet": ["hermes", "config", "set"],
  "config": [
    { "key": "gateway.platforms.uffici.enabled", "value": "true" },
    { "key": "display.platforms.uffici.long_running_notifications", "value": "false" },
    { "key": "display.memory_notifications", "value": "off" },
    {
      "key": "memory.provider",
      "value": "uffici-for-hermes",
      "note": "Uffici memory is this Hermes's memory provider now, on every platform it serves: a turn that is not a Uffici conversation recalls nothing."
    },
    {
      "key": "memory.memory_enabled",
      "value": "false",
      "note": "This Hermes's own MEMORY.md is off, on every platform it serves."
    },
    {
      "key": "memory.user_profile_enabled",
      "value": "false",
      "note": "This Hermes's own USER.md is off, on every platform it serves."
    }
  ],
  "envPath": ["hermes", "config", "env-path"],
  "envFile": ".env",
  "env": {
    "UFFICI_WIRE_SOCKET": "${wireSocket}",
    "UFFICI_WIRE_TOKEN_FILE": "${wireTokenFile}"
  },
  "restart": "Restart the Hermes gateway (`hermes gateway`) so it loads the plugin; the agent shows Online in the portal once it does.",
  "restartCommand": ["hermes", "gateway", "restart"],
  "restartService": { "systemd": "hermes-gateway", "launchd": "ai.hermes.gateway" }
}
